# ──────────────────────────────────────────────────────────────────────────────
# EasyModerator — Production Environment Variables
# Copy this file to .env.prod and fill in all values.
# NEVER commit .env.prod to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string — matches docker-compose service name "postgres"
DATABASE_URL=postgresql://easymod_user:CHANGE_ME@postgres:5432/easymod
DB_USER=easymod_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_NAME=easymod

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=            # set if you enable requirepass in redis
REDIS_SESSION_DB=0
REDIS_CACHE_DB=1
REDIS_RATELIMIT_DB=2

# ── JWT / Session ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars
SESSION_SECRET=CHANGE_ME_min_32_chars
CSRF_SECRET=CHANGE_ME_min_32_chars
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ── Encryption keys ──────────────────────────────────────────────────────────
# 32-byte hex keys — generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
DELIVERY_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars
CHANNEL_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# ── CORS / URLs ───────────────────────────────────────────────────────────────
# Marketing uses the public lead endpoint and the merchant app makes
# credentialed API calls. Keep an exact allowlist; never use `*`.
MARKETING_URL=https://easymod.tech
APP_URL=https://app.easymod.tech
API_URL=https://api.easymod.tech
PUBLIC_ASSET_URL=https://api.easymod.tech
CORS_ORIGINS=https://app.easymod.tech

# Compatibility aliases used by existing modules. Production validation rejects
# conflicting values, so these must match the canonical origins above.
FRONTEND_URL=https://app.easymod.tech
BASE_URL=https://api.easymod.tech
PUBLIC_BASE_URL=https://api.easymod.tech
META_OAUTH_REDIRECT_URI=https://app.easymod.tech/channels/oauth-callback

# ── Meta Platform ────────────────────────────────────────────────────────────
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
# Set this in your Meta App Dashboard → Webhook URL:
# https://api.easymod.tech/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# ── Qdrant (RAG vector DB) ────────────────────────────────────────────────────
# Internal service name — no port exposed publicly
QDRANT_URL=http://qdrant:6333

# ── AI / LLM ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME          # optional fallback LLM

# ── Payment callbacks ────────────────────────────────────────────────────────
PAYMENT_CALLBACK_HMAC_SECRET=CHANGE_ME
# Comma-separated IP allowlist for payment gateway callbacks
PAYMENT_GATEWAY_IP_ALLOWLIST=

# ── BKash ────────────────────────────────────────────────────────────────────
BKASH_ENABLED=true
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_APP_KEY=CHANGE_ME
BKASH_APP_SECRET=CHANGE_ME
BKASH_USERNAME=CHANGE_ME
BKASH_PASSWORD=CHANGE_ME
BKASH_WEBHOOK_SECRET=CHANGE_ME_min_32_chars
BKASH_SANDBOX=false

# ── Delivery providers ────────────────────────────────────────────────────────
PATHAO_CLIENT_ID=CHANGE_ME
PATHAO_CLIENT_SECRET=CHANGE_ME
STEADFAST_API_KEY=CHANGE_ME
STEADFAST_SECRET_KEY=CHANGE_ME

# ── Worker / Job control ──────────────────────────────────────────────────────
START_EMBEDDED_WORKERS=false       # always false in docker-compose (dedicated worker service)
RUN_MIGRATIONS_ON_STARTUP=false    # migrations run as deploy step

# ── Logging / Monitoring ─────────────────────────────────────────────────────
SENTRY_DSN=
SLACK_ALERT_WEBHOOK_URL=
# At least one of SENTRY_DSN or SLACK_ALERT_WEBHOOK_URL is required.
LOG_LEVEL=info

# ── Telegram (all required when enabled) ─────────────────────────────────────
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_min_32_chars

# ── Transactional email ───────────────────────────────────────────────────────
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=EasyModerator <no-reply@easymod.tech>

# Optional additional EasyModerator-controlled media hosts, comma-separated.
MEDIA_FETCH_ALLOWED_HOSTS=

# ── Cookie domain ────────────────────────────────────────────────────────────
# Leave unset so auth/session/CSRF cookies are host-only to api.easymod.tech.
# COOKIE_DOMAIN=
# Temporary migration-only cleanup for cookies previously scoped to .easymod.tech.
LEGACY_COOKIE_DOMAIN=easymod.tech

# ── Security ─────────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
BODY_SIZE_LIMIT=35mb
# Per-tenant cumulative product-image storage cap on the persistent uploads volume.
PRODUCT_IMAGE_QUOTA_BYTES=104857600
