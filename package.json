{
  "name": "easymoderator-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EasyModerator backend, frontend, and Growth OS monorepo",
  "workspaces": [
    "EasyMod-backend",
    "EasyMod-frontend",
    "EasyMod-growth"
  ],
  "scripts": {
    "install:all": "npm install --workspaces",
    "test:backend": "npm test --workspace=easymod-backend",
    "test:backend:integration": "npm run test:integration --workspace=easymod-backend",
    "test:backend:integration:docker": "node scripts/run-backend-integration.js",
    "test:backend:meta:e2e:docker": "node scripts/run-backend-meta-e2e.js",
    "test:frontend": "npm run test:unit --workspace=easymod-frontend",
    "test:growthos": "npm run test --workspace=easymod-growth",
    "test:growthos:e2e": "node scripts/run-growth-e2e.js",
    "test:extension": "node --test EasyMod-extension/test/capture.test.js EasyMod-extension/test/manifest.test.js EasyMod-extension/test/popup.test.js EasyMod-extension/test/relay.test.js",
    "validate:extension": "node EasyMod-extension/validate.js",
    "test:all": "npm run test:backend && npm run test:frontend && npm run test:growthos && npm run test:extension",
    "build:backend": "npm run build --workspace=easymod-backend",
    "build:frontend": "npm run build --workspace=easymod-frontend",
    "build:growthos": "npm run build --workspace=easymod-growth",
    "build:all": "npm run build:backend && npm run build:frontend && npm run build:growthos",
    "recovery:gate": "node scripts/recovery-gate/index.js"
  },
  "engines": {
    "node": "20.x"
  }
}
