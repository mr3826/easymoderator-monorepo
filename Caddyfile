# EasyModerator canonical production origins
#
#   easymod.tech      marketing and public/legal pages
#   app.easymod.tech  merchant SaaS frontend
#   api.easymod.tech  API, webhooks, health, and public backend assets
#
# Public paths are host-native: app routes do not carry /app and API routes do
# not carry /api. Express keeps its internal /api mount; Caddy translates at
# the edge. Compatibility is intentional during migration:
# - api.easymod.tech/api/* and apex /api/* still reach the same backend routes
# - legacy /app/* browser routes redirect to clean app paths
# - provider/API requests are rewritten internally so methods and bodies survive

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.easymod.tech {
	import security_headers
	redir https://easymod.tech{uri} 301
}

api.easymod.tech {
	import security_headers
	# Health and uploaded assets are mounted outside Express's internal /api
	# router and therefore pass through unchanged.
	@health path /health /health/*
	handle @health {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@uploads path /uploads /uploads/*
	handle @uploads {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Temporary compatibility for clients and provider dashboards that still
	# send /api/*. Never redirect non-GET requests during this window.
	@legacy_api path /api /api/*
	handle @legacy_api {
		header Deprecation "true"
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	# Canonical public API: /webhooks/meta, /auth/signin, /order, /version, etc.
	# Rewrite only inside the proxy; the browser/provider never sees /api.
	handle {
		rewrite * /api{uri}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	log {
		output stdout
		format json
	}
}

app.easymod.tech {
	import security_headers
	# Public acquisition and legal content has exactly one indexable home.
	@marketing_routes path /pricing /privacy-policy /terms
	redir @marketing_routes https://easymod.tech{uri} 301

	@legacy_settings path /settings/channels
	redir @legacy_settings /manage-shop/chat-settings 308

	@legacy_app_root path /app
	redir @legacy_app_root /dashboard 308

	@legacy_merchant_users path /app/admin/users
	redir @legacy_merchant_users /team/users 308

	@legacy_app_prefixed path /app/*
	handle @legacy_app_prefixed {
		route {
			uri strip_prefix /app
			redir {uri} 308
		}
	}

	# Authenticated/product routes must not be indexed even if a crawler reaches
	# them without credentials. The frontend root loader sends authenticated
	# merchants to /dashboard and anonymous visitors to /signin.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy frontend:8080

	log {
		output stdout
		format json
	}
}

easymod.tech {
	import security_headers
	@legacy_login path /login
	redir @legacy_login https://app.easymod.tech/signin 302

	@legacy_settings path /settings/channels
	redir @legacy_settings https://app.easymod.tech/manage-shop/chat-settings 302

	@legacy_app_root path /app
	redir @legacy_app_root https://app.easymod.tech/dashboard 302

	@legacy_merchant_users path /app/admin/users
	redir @legacy_merchant_users https://app.easymod.tech/team/users 302

	# Strip the obsolete /app namespace while keeping the suffix and query.
	@legacy_app_prefixed path /app/*
	handle @legacy_app_prefixed {
		route {
			uri strip_prefix /app
			redir https://app.easymod.tech{uri} 302
		}
	}

	# Clean merchant paths have one owner even if an old bookmark reaches the
	# marketing hostname.
	@merchant_routes {
		path /signin /signup /forgot-password /reset-password /2fa-verify /dashboard /inbox /channels /channels/* /manage-shop /manage-shop/* /products /products/* /categories /categories/* /orders /orders/* /customers /customers/* /knowledge /reports /audit-logs /subscription /team /team/* /admin /admin/*
	}
	redir @merchant_routes https://app.easymod.tech{uri} 302

	# Keep the old backend contract alive until provider dashboards, persisted
	# attachments, bookmarks, and launch tooling have all migrated.
	@health path /health /health/*
	handle @health {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	@legacy_webhooks path /webhooks /webhooks/*
	handle @legacy_webhooks {
		rewrite * /api{uri}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /uploads/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Marketing/public site.
	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format json
	}
}

growth.easymod.tech {
    # ── Growth OS backend API proxy ─────────────────────────────────────────
    # Keep this host limited to the auth/session contract used by the Growth
    # SPA. Merchant and provider APIs remain on their canonical hosts.
    @growth_api path /api/csrf /api/auth/* /api/internal/growth-os/*
    handle @growth_api {
        reverse_proxy backend:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                read_timeout 120s
                write_timeout 120s
            }
        }
    }

    # Never let an unsupported API path fall through to the SPA and look like
    # a successful HTML response.
    handle /api/* {
        respond "Not found" 404
    }

    # ── Growth OS SPA ───────────────────────────────────────────────────────
    handle {
        reverse_proxy growth-frontend:8080
    }

    log {
        output stdout
        format json
    }
}
