PORT=3000
NODE_ENV=development
DATABASE_URL=DB_URL

# Redis Configuration - Multi-DB Setup
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Redis Database Allocation
REDIS_SESSION_DB=0    # Sessions & conversation state
REDIS_CACHE_DB=1     # Product/FAQ cache  
REDIS_RATELIMIT_DB=2  # Rate limiting & API throttling

BODY_SIZE_LIMIT=1mb
ALLOW_SELF_SIGNED_TLS=false
CORS_ORIGINS=http://localhost:5173,https://app.example.com
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-change-in-production
PAYMENT_ENCRYPTION_KEY=your-32-byte-payment-encryption-key
MAKE_WEBHOOK_URL=
MAKE_INTERNAL_AUTH=
INTERNAL_WEBHOOK_SECRET=
WF1_WEBHOOK_URL=

# Pinecone (primary vector database)
PINECONE_API_KEY=
PINECONE_INDEX=easymod-knowledge
PINECONE_NAMESPACE=knowledge_base

# Qdrant (legacy fallback)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_documents
QDRANT_VECTOR_SIZE=384
QDRANT_API_KEY=
EMBEDDING_PROVIDER=anthropic
EMBEDDING_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
FRONTEND_URL=http://localhost:5173
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_APP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@easymod.local
