PORT=3000
NODE_ENV=development
DATABASE_URL=DB_URL

# Set to true when running a single process locally (starts BullMQ worker inline).
# In production this is false — the worker runs as a separate Docker container.
START_EMBEDDED_WORKERS=true

# Redis Configuration - Multi-DB Setup
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Redis Database Allocation
REDIS_SESSION_DB=0    # Sessions & conversation state
REDIS_CACHE_DB=1     # Product/FAQ cache  
REDIS_RATELIMIT_DB=2  # Rate limiting & API throttling

BODY_SIZE_LIMIT=1mb
ALLOW_SELF_SIGNED_TLS=false
CORS_ORIGINS=http://localhost:5173,https://app.example.com
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-change-in-production
PAYMENT_ENCRYPTION_KEY=your-32-byte-payment-encryption-key
# 64-char hex string (32 bytes) used to AES-256-CBC encrypt Meta System User tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=your-64-hex-channel-encryption-key-change-in-production
MAKE_WEBHOOK_URL=
MAKE_INTERNAL_AUTH=
INTERNAL_WEBHOOK_SECRET=
WF1_WEBHOOK_URL=

# ── Vector DB ──────────────────────────────────────────────────────────────────
# Testing: Pinecone (serverless — no infra needed)
# Production: unset PINECONE_API_KEY and set QDRANT_URL to your self-hosted instance
PINECONE_API_KEY=
PINECONE_INDEX=easymod-vdb
# PINECONE_HOST: paste the Index Host from the Pinecone console (skips control-plane lookup)
PINECONE_HOST=
PINECONE_NAMESPACE=knowledge_base
QDRANT_PER_TENANT=true        # each shop gets its own namespace/collection

# Qdrant (production self-hosted fallback when PINECONE_API_KEY is empty)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_documents
QDRANT_API_KEY=

# ── LLM Provider: Gemini (primary) + OpenAI (fallback) ───────────────────────
LLM_PROVIDER=gemini
LLM_GEMINI_TIMEOUT_MS=10000
LLM_OPENAI_TIMEOUT_MS=8000

# ── AI bot attribution (Meta Platform Policy 4.2) ────────────────────────────
# Append a small marker to AI-generated replies so customers know the message
# was automated. Default: enabled, " 🤖" suffix. Set ENABLED=false to disable
# globally; override SUFFIX to customize the marker (e.g. " (AI)").
AI_BOT_ATTRIBUTION_ENABLED=true
AI_BOT_ATTRIBUTION_SUFFIX= 🤖

EMBEDDING_PROVIDER=http
EMBEDDING_API_URL=http://localhost:8080/embed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: only needed if your TEI endpoint requires auth
EMBEDDING_API_KEY=
# Retry/cold-start tuning
EMBEDDING_HTTP_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_MS=1200
QDRANT_VECTOR_SIZE=384

# ── AI Provider Keys ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
FRONTEND_URL=http://localhost:5173
META_WEBHOOK_APP_SECRET=
# Verify token configured under Meta App Dashboard > Webhooks > Edit Subscription.
# Required for App Review — Meta's GET /webhooks/meta?hub.challenge handshake
# uses this single global value at dashboard-config time.
META_WEBHOOK_VERIFY_TOKEN=

# Meta OAuth (Business Login) — required for Facebook/Instagram channel connection
# Get from: developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Must exactly match the URI registered in Facebook App → Facebook Login → Valid OAuth Redirect URIs
META_OAUTH_REDIRECT_URI=http://localhost:5173/app/channels/oauth-callback
# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Sign up at resend.com, create an API key, and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=Easy Moderator <no-reply@easymod.co>

# ── Admin / Ops ───────────────────────────────────────────────────────────────
# Email address that receives Partner plan applications and internal alerts
ADMIN_EMAIL=hello@hexabyte.co
# Webhook URL for guardrail escalation alerts (Slack/Discord/n8n incoming webhook)
OPS_ESCALATION_WEBHOOK_URL=

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Create a project at sentry.io, copy the DSN from Settings → Client Keys
SENTRY_DSN=
