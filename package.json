{
  "name": "easymod-backend",
  "version": "1.0.0",
  "description": "EasyMod Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:worker": "node src/jobs/worker.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "db:sync": "node src/utils/database/sync.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "seed:conversations": "node src/scripts/seed-conversations.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:down": "node src/database/migrate.js down",
    "migrate:down:all": "node src/database/migrate.js down:all",
    "migrate:status": "node src/database/migrate.js status",
    "cleanup": "powershell -ExecutionPolicy Bypass -File cleanup.ps1",
    "setup:secrets": "node scripts/setup-secrets.js",
    "backup:create": "node scripts/backup-database.js create",
    "backup:list": "node scripts/backup-database.js list",
    "backup:restore": "node scripts/backup-database.js restore",
    "setup:monitoring": "node scripts/setup-monitoring.js",
    "test:csrf": "node scripts/test-csrf.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/secret-manager": "^5.6.0",
    "@pinecone-database/pinecone": "^4.1.0",
    "@qdrant/qdrant-js": "^1.17.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.12.0",
    "bullmq": "^5.76.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "express-timeout-handler": "^2.2.2",
    "express-validator": "^7.3.1",
    "firebase-admin": "^13.8.0",
    "fs-extra": "^11.3.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pm2": "^5.3.0",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.12.2",
    "sequelize": "^6.37.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  },
  "_moduleAliases": {
    "src": "./src"
  }
}
