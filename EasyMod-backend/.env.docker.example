# Local Docker development secrets
# Copy this file to .env.docker and fill in your own values.
# .env.docker is git-ignored and must NEVER be committed.

# JWT Secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-your-local-dev-access-secret
JWT_REFRESH_SECRET=replace-with-your-local-dev-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_SECRET=replace-with-your-local-dev-session-secret

# Encryption keys (hex, 32 bytes) — generate with: openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY=replace-with-your-local-dev-payment-key
CHANNEL_ENCRYPTION_KEY=replace-with-your-local-dev-channel-key
DELIVERY_ENCRYPTION_KEY=replace-with-your-local-dev-delivery-key

# Internal webhook
INTERNAL_WEBHOOK_SECRET=replace-with-local-webhook-secret

# Leave blank for local dev (optional AI features)
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=
# Vector store: Qdrant (Pinecone removed). QDRANT_URL defaults to the compose service.
QDRANT_URL=http://qdrant:6333
