[Unit]
Description=Commerce AI Server
Documentation=https://github.com/your-username/commerce-ai-server
After=network.target postgresql.service redis.service

[Service]
Type=forking
User=ubuntu
WorkingDirectory=/home/ubuntu/commerce-ai/server-commerce-ai-dev
Environment=NODE_ENV=production
Environment=PATH=/usr/bin:/usr/local/bin
Environment=PM2_HOME=/home/ubuntu/.pm2

# Load environment variables from file
EnvironmentFile=/home/ubuntu/commerce-ai/server-commerce-ai-dev/.env

# Start PM2 with ecosystem config
ExecStart=/usr/local/bin/pm2 start /home/ubuntu/commerce-ai/server-commerce-ai-dev/ecosystem.config.js
ExecReload=/usr/local/bin/pm2 reload /home/ubuntu/commerce-ai/server-commerce-ai-dev/ecosystem.config.js
ExecStop=/usr/local/bin/pm2 stop /home/ubuntu/commerce-ai/server-commerce-ai-dev/ecosystem.config.js

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Resource limits
LimitNOFILE=65536
LimitNPROC=65536

# Standard output/error logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=commerce-ai

[Install]
WantedBy=multi-user.target
