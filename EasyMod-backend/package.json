{
  "name": "easymod-backend",
  "version": "1.0.0",
  "description": "EasyMod Backend Server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "node --check server.js",
    "start:worker": "node src/jobs/worker.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:integration": "jest --config jest.meta-e2e.config.js --runInBand --forceExit",
    "test:security": "jest src/config/__tests__/production-config.validator.test.js src/config/__tests__/production-integration.validator.test.js src/database/__tests__/meta-compliance.migration.test.js src/middleware/__tests__/auth-token-version.security.test.js src/middleware/__tests__/payment-callback-auth.middleware.test.js src/modules/admin/__tests__/meta-identity-readiness.security.test.js src/modules/analytics/__tests__/analytics-knowledge-gap.security.test.js src/modules/auth/__tests__/auth.security.test.js src/modules/channel-providers/__tests__/MetaMessengerProvider.test.js src/modules/channel-providers/__tests__/meta-authorization-recovery.service.test.js src/modules/conversation/__tests__/conversation-sse.security.test.js src/modules/delivery/__tests__/delivery-rag.routes.security.test.js src/modules/delivery/__tests__/delivery-tracking.tenant-and-replay.test.js src/modules/integration/__tests__/meta-compliance.service.test.js src/modules/integration/__tests__/meta-gdpr-security.test.js src/modules/notification/__tests__/notification-payment.routes.security.test.js src/modules/notification/__tests__/owner-notification.security.test.js src/modules/payment/__tests__/payment-processing-reconciliation.security.test.js src/modules/payment/__tests__/self-mfs-handler.media-security.test.js src/modules/webhooks/__tests__/payment-webhook.controller.test.js src/modules/webhooks/webhook.routes.contract.test.js src/security/__tests__/route-perimeter.test.js src/security/__tests__/workflow-deploy-guard.test.js src/security/__tests__/audit-tenant-scope.security.test.js src/security/__tests__/shop-tenant-scope.security.test.js src/modules/ai/__tests__/voice-processing.limits.test.js src/utils/__tests__/safe-media-fetch.test.js --runInBand",
    "test:watch": "jest --watch",
    "test:meta:e2e": "jest --config jest.meta-e2e.config.js --runInBand --forceExit",
    "test:meta:live": "node scripts/meta-live-e2e.js",
    "db:sync": "node src/utils/database/sync.js",
    "seed": "node src/database/seed.js",
    "seed:meta-bootstrap": "node src/database/seed-meta-bootstrap.js",
    "seed:admin": "node src/scripts/seed-admin.js",
    "seed:conversations": "node src/scripts/seed-conversations.js",
    "reindex:qdrant": "node src/scripts/reindex-qdrant.js",
    "ai:backfill-products": "node scripts/backfill-product-attributes.js",
    "schema:audit": "node scripts/schema-drift-audit.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:down": "node src/database/migrate.js down",
    "migrate:down:all": "node src/database/migrate.js down:all",
    "migrate:status": "node src/database/migrate.js status",
    "migrate:seed-executed": "node src/database/migrate.js seed-as-executed",
    "setup:secrets": "node scripts/setup-secrets.js",
    "backup:create": "node scripts/backup-database.js create",
    "backup:list": "node scripts/backup-database.js list",
    "backup:restore": "node scripts/backup-database.js restore",
    "backup:media:restore": "node scripts/restore-media.js restore",
    "backup:media:verify": "node scripts/restore-media.js verify",
    "setup:monitoring": "node scripts/setup-monitoring.js",
    "launch:check": "node scripts/launch-readiness.js",
    "test:csrf": "node scripts/test-csrf.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prepare": "husky || true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@qdrant/qdrant-js": "^1.17.0",
    "@sentry/node": "^10.51.0",
    "@sentry/profiling-node": "^10.51.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "1.20.6",
    "bullmq": "^5.76.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.0",
    "express-timeout-handler": "^2.2.2",
    "express-validator": "^7.3.1",
    "fast-xml-parser": "5.10.1",
    "firebase-admin": "^13.8.0",
    "fs-extra": "^11.3.4",
    "helmet": "^8.1.0",
    "ioredis": "^5.3.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.2.3",
    "morgan": "1.11.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "rate-limit-redis": "^4.3.1",
    "resend": "^6.12.3",
    "sequelize": "^6.37.7",
    "undici": "6.28.0",
    "uuid": "11.1.1",
    "web-push": "^3.6.7",
    "websocket-driver": "0.7.5"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^6.0.1",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "_moduleAliases": {
    "src": "./src"
  }
}
