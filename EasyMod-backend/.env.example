PORT=3000
NODE_ENV=development
DATABASE_URL=DB_URL

# Set to true when running a single process locally (starts BullMQ worker inline).
# In production this is false — the worker runs as a separate Docker container.
START_EMBEDDED_WORKERS=true

# Redis Configuration - Multi-DB Setup
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Redis Database Allocation
REDIS_SESSION_DB=0    # Sessions & conversation state
REDIS_CACHE_DB=1     # Product/FAQ cache  
REDIS_RATELIMIT_DB=2  # Rate limiting & API throttling

BODY_SIZE_LIMIT=1mb
ALLOW_SELF_SIGNED_TLS=false
CORS_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=your-session-secret-change-in-production
PAYMENT_ENCRYPTION_KEY=your-32-byte-payment-encryption-key
# 64-char hex string (32 bytes) used to AES-256-CBC encrypt Meta System User tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=your-64-hex-channel-encryption-key-change-in-production
MAKE_WEBHOOK_URL=
MAKE_INTERNAL_AUTH=
INTERNAL_WEBHOOK_SECRET=
WF1_WEBHOOK_URL=

# ── Vector DB (Qdrant — single vector store; Pinecone removed 2026-05-31) ──────
# Point QDRANT_URL at the server root (no /v1/ prefix), e.g. http://qdrant:6333.
# In production run Qdrant on a VPC-internal IP and set QDRANT_API_KEY.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=knowledge_documents
QDRANT_API_KEY=
QDRANT_PER_TENANT=true        # each shop gets its own collection (strict isolation)

# ── LLM Provider: Gemini (primary) + OpenAI (fallback) ───────────────────────
LLM_PROVIDER=gemini
LLM_GEMINI_TIMEOUT_MS=10000
LLM_OPENAI_TIMEOUT_MS=8000

# ── Embedding provider (powers ALL semantic search / RAG retrieval) ──────────
# Valid values:
#   openai          → OpenAI embeddings   (requires OPENAI_API_KEY)
#   http | tei | gcp → HTTP embedding server / TEI (requires EMBEDDING_API_URL)
#   local | <unset>  → NON-SEMANTIC n-gram fallback — DEV ONLY. In production this
#                      makes the chatbot hallucinate (retrieval returns near-random
#                      matches). /health/detailed reports embedding.semantic=false.
EMBEDDING_PROVIDER=http
EMBEDDING_API_URL=http://localhost:8080/embed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: only needed if your TEI endpoint requires auth
EMBEDDING_API_KEY=
# Retry/cold-start tuning
EMBEDDING_HTTP_MAX_RETRIES=3
EMBEDDING_RETRY_BACKOFF_MS=1200
QDRANT_VECTOR_SIZE=384

# ── AI Provider Keys ──────────────────────────────────────────────────────────
# NOTE: a FREE Gemini key is capped at 15 requests/minute for the whole app, and
# a customer photo message costs two calls. Use a paid-tier key in production.
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# ── Image understanding ───────────────────────────────────────────────────────
# Customer sends a product photo ("eita ache?") → one extraction call turns it
# into searchable attributes → the reply is grounded on live catalog rows.
# ON by default; set to false to shed the cost/rate-limit load without a deploy.
# ~1,065-1,090 input tokens per photo, billed flat regardless of resolution.
AI_PHOTO_MATCH_ENABLED=true
# Everything else image-related: analysing the MERCHANT's product images on
# upload, and re-attaching the customer's photo to the final reply call. Both
# measured as not worth it — attributes derived from the merchant's own text beat
# the vision path by 4.1 points of rank-1 accuracy at zero cost. Leave off.
AI_VISION_ENABLED=false
MARKETING_URL=http://localhost:5173
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
PUBLIC_ASSET_URL=http://localhost:3000
# Compatibility aliases consumed by older modules.
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Production: keep COOKIE_DOMAIN unset; use this only during the migration cleanup window.
LEGACY_COOKIE_DOMAIN=
# Verify token configured under Meta App Dashboard > Webhooks > Edit Subscription.
# Required for App Review — Meta's GET /webhooks/meta?hub.challenge handshake
# uses this single global value at dashboard-config time.
META_WEBHOOK_VERIFY_TOKEN=

# Meta OAuth (Business Login) — required for Facebook Page Messenger connection
# Get from: developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Must exactly match the URI registered in Facebook App → Facebook Login → Valid OAuth Redirect URIs
META_OAUTH_REDIRECT_URI=http://localhost:5173/app/channels/oauth-callback
# ── Transactional Email (Resend) ──────────────────────────────────────────────
# Sign up at resend.com, create an API key, and verify your sending domain.
# IMPORTANT: the domain in EMAIL_FROM must be a VERIFIED sending domain in your
# Resend account, or every send is rejected (403) — including password-reset
# emails. Use the canonical product domain (easymod.tech).
RESEND_API_KEY=
EMAIL_FROM=Easy Moderator <no-reply@easymod.tech>

# ── Admin / Ops ───────────────────────────────────────────────────────────────
# Email address that receives Partner plan applications and internal alerts
ADMIN_EMAIL=hello@hexabyte.co
# Webhook URL for guardrail escalation alerts (Slack/Discord/n8n incoming webhook)
OPS_ESCALATION_WEBHOOK_URL=

# ── Error Tracking (Sentry) ───────────────────────────────────────────────────
# Create a project at sentry.io, copy the DSN from Settings → Client Keys
SENTRY_DSN=

# ── Reliability alerting (auto-reply canary + DLQ watchdog) ───────────────────
# Incoming-webhook URL for ops alerts (Slack/Discord/n8n). Set at least one of
# this or SENTRY_DSN, otherwise pipeline failures are logged but nobody is paged.
SLACK_ALERT_WEBHOOK_URL=
# One global EasyModerator Telegram bot used for merchant alert groups only.
# Create the bot with BotFather, set the production webhook URL to:
#   https://<api-domain>/api/webhooks/telegram
# Set the same secret via Telegram setWebhook secret_token and here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Merchant waiting-alert tuning (optional). A HITL conversation gets an alert
# when the latest customer message stays unanswered beyond this window.
CUSTOMER_WAITING_ALERT_MINUTES=30
CUSTOMER_WAITING_ALERT_SCAN_LIMIT=200
# Canary tuning (all optional — sane defaults applied if unset):
#   CANARY_MAX_STALENESS_MS  alert if no canary completes within this window (default 900000 = 15m)
#   CANARY_DLQ_THRESHOLD     alert when message-dlq depth reaches this (default 1)
#   CANARY_BACKLOG_THRESHOLD warn when message-processing backlog reaches this (default 200)
CANARY_MAX_STALENESS_MS=
CANARY_DLQ_THRESHOLD=
CANARY_BACKLOG_THRESHOLD=
# Per-title dedup window for ops alerts so a systemic failure pages once, not
# once per message (default 300000 = 5m; set 0 to disable throttling).
OPS_ALERT_THROTTLE_MS=
