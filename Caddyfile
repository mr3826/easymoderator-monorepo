# EasyModerator canonical production origins
#
#   easymod.tech      marketing and public/legal pages
#   app.easymod.tech  merchant SaaS frontend
#   api.easymod.tech  API, webhooks, health, and public backend assets
#
# Compatibility is intentional during migration:
# - apex /api/*, /health*, and /uploads/* continue to reach the backend
# - legacy apex merchant routes redirect to app.easymod.tech
# - legacy /webhooks/* is rewritten internally; provider POSTs are never redirected

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

www.easymod.tech {
	import security_headers
	redir https://easymod.tech{uri} 301
}

api.easymod.tech {
	import security_headers
	# Some old provider registrations used /webhooks/* without /api. Preserve the
	# HTTP method and request body by rewriting internally rather than redirecting.
	@legacy_webhooks path /webhooks /webhooks/*
	handle @legacy_webhooks {
		rewrite * /api{uri}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	log {
		output stdout
		format json
	}
}

app.easymod.tech {
	import security_headers
	# Public acquisition and legal content has exactly one indexable home.
	@marketing_routes path /pricing /privacy-policy /terms
	redir @marketing_routes https://easymod.tech{uri} 301

	# The app root is an entry point, not a duplicate marketing homepage. The
	# frontend auth loader moves an authenticated merchant onward to /app.
	@app_root path /
	redir @app_root /signin 302

	# Authenticated/product routes must not be indexed even if a crawler reaches
	# them without credentials.
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy frontend:8080

	log {
		output stdout
		format json
	}
}

easymod.tech {
	import security_headers
	# Browser-route compatibility. Query strings are retained by {uri}, including
	# reset tokens and the legacy Meta OAuth completion URL.
	@legacy_app_routes path \
 /login /signin /signup /forgot-password /reset-password /2fa-verify \
 /app /app/* /admin /admin/* /settings/channels
	redir @legacy_app_routes https://app.easymod.tech{uri} 302

	# Keep the old backend contract alive until provider dashboards, persisted
	# attachments, bookmarks, and launch tooling have all migrated.
	@health path /health /health/*
	handle @health {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /api/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	@legacy_webhooks path /webhooks /webhooks/*
	handle @legacy_webhooks {
		rewrite * /api{uri}
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle /uploads/* {
		reverse_proxy backend:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Marketing/public site.
	handle {
		reverse_proxy frontend:8080
	}

	log {
		output stdout
		format json
	}
}
