FROM node:20-alpine

WORKDIR /app

# Install build dependencies including postgresql client for connection checks
RUN apk add --no-cache postgresql-client bash

# Copy package files
COPY package*.json ./

# Install exactly the checked-in dependency graph
RUN npm ci

# Copy source code
COPY . .

# Copy entrypoint script
COPY docker-entrypoint.sh /app/
RUN chmod +x /app/docker-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["npm", "run", "dev"]
